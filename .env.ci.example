# API endpoint used by a manually triggered Newman workflow.
SIMPELAPPI_API_BASE_URL=https://api.example.invalid/api/v1

# Database connection used by the monthly KPI workflow.
SIMPELAPPI_DB_HOST=db.example.invalid
SIMPELAPPI_DB_PORT=5432
SIMPELAPPI_DB_NAME=simpelappi
SIMPELAPPI_DB_USER=simpelappi_ci
SIMPELAPPI_DB_PASSWORD=replace-with-a-github-actions-secret

# API runtime configuration. JWT_SECRET must contain at least 32 random characters.
DATABASE_URL=postgresql://simpelappi:replace-me@localhost:5432/simpelappi
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=simpelappi-auth
JWT_AUDIENCE=simpelappi-api
SIMPELAPPI_TEST_PASSWORD=replace-with-a-strong-shared-ci-test-password
