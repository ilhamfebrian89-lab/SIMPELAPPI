{
  "name": "simpelappi",
  "version": "1.0.0",
  "description": "Proyek ini berisi prototype statis awal untuk SIMPELAPPI berdasarkan spesifikasi UX/UI dan domain-driven design.",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:vercel": "node scripts/build-static.mjs",
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "user:set-password": "tsx src/cli/set-user-password.ts",
    "user:set-password:prod": "node dist/cli/set-user-password.js"
  },
  "keywords": [
    "fastify",
    "infection-prevention",
    "simpelappi"
  ],
  "author": "SIMPELAPPI contributors",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/jwt": "^10.2.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/type-provider-typebox": "^5.2.0",
    "@sinclair/typebox": "^0.34.52",
    "fastify": "^5.11.0",
    "fastify-plugin": "^5.1.0",
    "pg": "^8.22.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/pg": "^8.20.3",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
