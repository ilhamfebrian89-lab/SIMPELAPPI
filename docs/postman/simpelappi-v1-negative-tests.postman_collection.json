{
  "info": {
    "name": "SIMPELAPPI API v1 - Negative Tests",
    "_postman_id": "0dfe7871-678d-4ecf-aa9f-d332b9fa5315",
    "description": "Negative test scenarios for validation, RBAC, and conflict handling.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication Setup",
      "item": [
        {
          "name": "Login IPCN",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('IPCN login should succeed', function () { pm.response.to.have.status(200); });",
                  "pm.environment.set('accessToken', pm.response.json().data.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Login Director",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Director login should succeed', function () { pm.response.to.have.status(200); });",
                  "pm.environment.set('directorToken', pm.response.json().data.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{directorUsername}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "AUTH-403 Unauthorized Write",
      "item": [
        {
          "name": "Director tries create monitoring",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status should be 403', function () { pm.response.to.have.status(403); });",
                  "pm.test('Error code should be AUTH-403', function () { pm.expect(pm.response.json().errors[0].code).to.eql('AUTH-403'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{directorToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"monitoringDate\": \"2026-08-01\",\n  \"unitId\": \"11111111-1111-1111-1111-111111111111\",\n  \"observerUserId\": \"22222222-2222-2222-2222-222222222221\",\n  \"items\": [{\"questionCode\": \"HH-01\", \"answerValue\": \"yes\", \"scoreValue\": 1}]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/monitoring",
              "host": ["{{baseUrl}}"],
              "path": ["monitoring"]
            }
          }
        }
      ]
    },
    {
      "name": "VAL-001 Required Field",
      "item": [
        {
          "name": "Create monitoring without unitId",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status should be 400', function () { pm.response.to.have.status(400); });",
                  "pm.test('Error code should be VAL-001', function () { pm.expect(pm.response.json().errors[0].code).to.eql('VAL-001'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"monitoringDate\": \"2026-08-01\",\n  \"observerUserId\": \"22222222-2222-2222-2222-222222222223\",\n  \"items\": [{\"questionCode\": \"HH-01\", \"answerValue\": \"yes\", \"scoreValue\": 1}]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/monitoring",
              "host": ["{{baseUrl}}"],
              "path": ["monitoring"]
            }
          }
        }
      ]
    },
    {
      "name": "BIZ-409 Conflict",
      "item": [
        {
          "name": "Submit already closed RTL",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status should be 409', function () { pm.response.to.have.status(409); });",
                  "pm.test('Error code should be BIZ-409', function () { pm.expect(pm.response.json().errors[0].code).to.eql('BIZ-409'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"progressPercent\": 80,\n  \"comment\": \"force update\",\n  \"updatedBy\": \"22222222-2222-2222-2222-222222222223\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/rtl/{{closedRtlId}}/progress",
              "host": ["{{baseUrl}}"],
              "path": ["rtl", "{{closedRtlId}}", "progress"]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api/v1" },
    { "key": "username", "value": "ipcn_admin" },
    { "key": "directorUsername", "value": "director_test" },
    { "key": "password", "value": "" },
    { "key": "accessToken", "value": "" },
    { "key": "directorToken", "value": "" },
    { "key": "closedRtlId", "value": "77777777-7777-7777-7777-777777777703" }
  ]
}
